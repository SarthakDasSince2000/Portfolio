<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 480" width="320" height="480">
  <defs>
    <radialGradient id="holoPlatform" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#d8ff52" stop-opacity="0.6"/>
      <stop offset="40%" stop-color="#38ef7d" stop-opacity="0.3"/>
      <stop offset="100%" stop-color="#111915" stop-opacity="0"/>
    </radialGradient>
    <linearGradient id="jacketGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#1e3328"/>
      <stop offset="50%" stop-color="#14241c"/>
      <stop offset="100%" stop-color="#0a140f"/>
    </linearGradient>
    <linearGradient id="shirtGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#2c4436"/>
      <stop offset="100%" stop-color="#17261e"/>
    </linearGradient>
    <linearGradient id="pantsGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#18231e"/>
      <stop offset="100%" stop-color="#0d1411"/>
    </linearGradient>
    <linearGradient id="skinGrad" x1="30%" y1="20%" x2="70%" y2="80%">
      <stop offset="0%" stop-color="#d99f78"/>
      <stop offset="60%" stop-color="#bd7d54"/>
      <stop offset="100%" stop-color="#8d5432"/>
    </linearGradient>
    <linearGradient id="hairGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#2a1810"/>
      <stop offset="100%" stop-color="#120a06"/>
    </linearGradient>
    <linearGradient id="shoesGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#2f4639"/>
      <stop offset="100%" stop-color="#111c16"/>
    </linearGradient>
    <linearGradient id="tabletGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#2a3a30"/>
      <stop offset="100%" stop-color="#101814"/>
    </linearGradient>
    <filter id="softGlow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="4" result="blur"/>
      <feComposite in="SourceGraphic" in2="blur" operator="over"/>
    </filter>
  </defs>

  <!-- Ground Hologram Disc -->
  <ellipse cx="160" cy="452" rx="110" ry="22" fill="url(#holoPlatform)"/>
  <ellipse cx="160" cy="452" rx="100" ry="18" fill="none" stroke="#d8ff52" stroke-width="1.5" stroke-dasharray="6 8" opacity="0.75" filter="url(#softGlow)"/>
  <ellipse cx="160" cy="452" rx="65" ry="11" fill="none" stroke="#38ef7d" stroke-width="1" stroke-dasharray="3 6" opacity="0.5"/>

  <!-- Vertical Digital Aura Beams -->
  <line x1="65" y1="440" x2="65" y2="390" stroke="#d8ff52" stroke-width="1.5" stroke-linecap="round" opacity="0.4"/>
  <circle cx="65" cy="385" r="2.5" fill="#d8ff52" opacity="0.8"/>
  <line x1="255" y1="445" x2="255" y2="405" stroke="#38ef7d" stroke-width="1.5" stroke-linecap="round" opacity="0.4"/>
  <circle cx="255" cy="400" r="2.5" fill="#38ef7d" opacity="0.8"/>
  <line x1="95" y1="455" x2="95" y2="425" stroke="#ff795b" stroke-width="1" stroke-linecap="round" opacity="0.35"/>

  <!-- Shoes -->
  <!-- Left Shoe -->
  <path d="M 130 435 L 126 448 Q 120 455 138 456 L 152 454 Q 155 448 150 435 Z" fill="url(#shoesGrad)" stroke="#385444" stroke-width="1.5"/>
  <path d="M 126 453 L 148 453" stroke="#d8ff52" stroke-width="2" opacity="0.85"/>
  <!-- Right Shoe -->
  <path d="M 168 435 L 166 448 Q 164 455 182 456 L 196 454 Q 198 448 190 435 Z" fill="url(#shoesGrad)" stroke="#385444" stroke-width="1.5"/>
  <path d="M 168 453 L 192 453" stroke="#d8ff52" stroke-width="2" opacity="0.85"/>

  <!-- Trousers / Legs -->
  <!-- Left Leg -->
  <path d="M 132 270 L 128 436 L 150 436 L 158 275 Z" fill="url(#pantsGrad)" stroke="#223329" stroke-width="1.5"/>
  <!-- Right Leg -->
  <path d="M 162 275 L 168 436 L 190 436 L 188 270 Z" fill="url(#pantsGrad)" stroke="#223329" stroke-width="1.5"/>

  <!-- Torso & Shirt -->
  <path d="M 120 150 L 126 280 L 194 280 L 200 150 Z" fill="url(#shirtGrad)" stroke="#1a2e22" stroke-width="1.5"/>
  <line x1="160" y1="150" x2="160" y2="280" stroke="#365040" stroke-width="1.5"/>

  <!-- Belt -->
  <rect x="126" y="272" width="68" height="9" rx="2" fill="#0b130e" stroke="#2c4436" stroke-width="1"/>
  <rect x="154" y="271" width="12" height="11" rx="2" fill="#d8ff52" opacity="0.85"/>

  <!-- Jacket / Blazer (Open front) -->
  <!-- Left Jacket Panel -->
  <path d="M 116 142 C 102 180, 106 250, 118 292 L 144 286 L 138 180 L 150 144 Z" fill="url(#jacketGrad)" stroke="#2b4637" stroke-width="2"/>
  <!-- Right Jacket Panel -->
  <path d="M 204 142 C 218 180, 214 250, 202 292 L 176 286 L 182 180 L 170 144 Z" fill="url(#jacketGrad)" stroke="#2b4637" stroke-width="2"/>

  <!-- Left Arm & Hand (Holding modern tech device) -->
  <path d="M 116 142 L 95 210 L 124 235 L 134 220 L 112 195 Z" fill="url(#jacketGrad)" stroke="#2b4637" stroke-width="2"/>
  <ellipse cx="130" cy="242" rx="9" ry="8" fill="url(#skinGrad)"/>
  <!-- Tablet / Device in Left Hand -->
  <rect x="120" y="222" width="38" height="26" rx="4" transform="rotate(-15 139 235)" fill="url(#tabletGrad)" stroke="#d8ff52" stroke-width="1.5" filter="url(#softGlow)"/>
  <line x1="126" y1="230" x2="148" y2="224" stroke="#38ef7d" stroke-width="1" stroke-linecap="round"/>
  <line x1="128" y1="236" x2="142" y2="232" stroke="#d8ff52" stroke-width="1" stroke-linecap="round"/>

  <!-- Right Arm (Relaxed at side) -->
  <path d="M 204 142 L 222 215 L 214 275 L 202 275 L 208 215 Z" fill="url(#jacketGrad)" stroke="#2b4637" stroke-width="2"/>
  <ellipse cx="208" cy="285" rx="7" ry="8" fill="url(#skinGrad)"/>

  <!-- Neck -->
  <path d="M 148 118 L 148 150 C 154 156, 166 156, 172 150 L 172 118 Z" fill="#9e5e38"/>

  <!-- Head / Face -->
  <ellipse cx="160" cy="94" rx="34" ry="40" fill="url(#skinGrad)"/>

  <!-- Hair -->
  <path d="M 126 88 C 124 58, 140 42, 160 40 C 180 42, 196 58, 194 88 C 188 64, 180 58, 160 58 C 140 58, 132 64, 126 88 Z" fill="url(#hairGrad)"/>
  <path d="M 130 68 C 144 50, 176 46, 190 60 C 178 52, 142 54, 130 68 Z" fill="#44281b" opacity="0.6"/>

  <!-- Ears -->
  <ellipse cx="126" cy="96" rx="5" ry="9" fill="#b5754d"/>
  <ellipse cx="194" cy="96" rx="5" ry="9" fill="#b5754d"/>

  <!-- Eyebrows -->
  <path d="M 138 82 Q 148 78, 154 83" stroke="#1c100a" stroke-width="2.5" stroke-linecap="round" fill="none"/>
  <path d="M 182 82 Q 172 78, 166 83" stroke="#1c100a" stroke-width="2.5" stroke-linecap="round" fill="none"/>

  <!-- Eyes -->
  <ellipse cx="147" cy="91" rx="4.5" ry="3.2" fill="#1a0f0a"/>
  <ellipse cx="173" cy="91" rx="4.5" ry="3.2" fill="#1a0f0a"/>
  <circle cx="148.5" cy="90" r="1.5" fill="#ffffff"/>
  <circle cx="174.5" cy="90" r="1.5" fill="#ffffff"/>

  <!-- Modern Tech Glasses -->
  <rect x="134" y="84" width="23" height="15" rx="4" fill="none" stroke="#d8ff52" stroke-width="1.8" stroke-opacity="0.9"/>
  <rect x="163" y="84" width="23" height="15" rx="4" fill="none" stroke="#d8ff52" stroke-width="1.8" stroke-opacity="0.9"/>
  <line x1="157" y1="91" x2="163" y2="91" stroke="#d8ff52" stroke-width="1.8" stroke-opacity="0.9"/>

  <!-- Nose -->
  <path d="M 160 91 L 158 105 Q 160 108, 163 106" stroke="#784222" stroke-width="1.8" fill="none" stroke-linecap="round"/>

  <!-- Mouth / Friendly subtle smile -->
  <path d="M 151 116 Q 160 122, 169 116" stroke="#683218" stroke-width="2.2" fill="none" stroke-linecap="round"/>

  <!-- Floating Holographic Nodes Around Head & Torso -->
  <circle cx="95" cy="115" r="3" fill="#d8ff52" filter="url(#softGlow)"/>
  <path d="M 88 125 A 35 35 0 0 1 105 85" fill="none" stroke="#38ef7d" stroke-width="1.2" stroke-dasharray="3 4" opacity="0.6"/>
  <circle cx="225" cy="105" r="2.5" fill="#ff795b" filter="url(#softGlow)"/>
  <circle cx="235" cy="175" r="3.5" fill="#d8ff52" filter="url(#softGlow)"/>

  <!-- Floating Mini Status Badge -->
  <g transform="translate(195, 30)">
    <rect width="88" height="22" rx="11" fill="#0e1a14" stroke="#2f4a3c" stroke-width="1.2"/>
    <circle cx="12" cy="11" r="3.5" fill="#22c55e"/>
    <text x="22" y="15" fill="#d8ff52" font-family="sans-serif" font-size="9" font-weight="bold" letter-spacing="0.5">AI TWIN</text>
  </g>
</svg>